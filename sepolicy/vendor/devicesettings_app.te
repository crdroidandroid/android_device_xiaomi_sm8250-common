# Allow devicesettings_app to find hal_touchfeature_xiaomi_hwservice
allow devicesettings_app hal_touchfeature_xiaomi_hwservice:hwservice_manager find;

# Allow binder communication with hal_touchfeature_xiaomi_default
binder_call(devicesettings_app, hal_touchfeature_xiaomi_default)

# Allow devicesettings_app to r/w vendor_sysfs_graphics
allow devicesettings_app vendor_sysfs_graphics:dir r_dir_perms;
allow devicesettings_app vendor_sysfs_graphics:file rw_file_perms;

# Allow devicesettings_app to find and call the display feature service
allow devicesettings_app vendor_hal_displayfeature_xiaomi_service:binder { call transfer };
allow devicesettings_app vendor_hal_displayfeature_xiaomi_default:binder { call transfer };
dontaudit devicesettings_app vendor_hal_displayfeature_xiaomi_service:service_manager { find };
dontaudit devicesettings_app vendor_hal_displayfeature_xiaomi_default:service_manager { find };
