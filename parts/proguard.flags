-keep class org.lineageos.settings.* {
  *;
}

-keep class org.lineageos.settings.misound.* {
  *;
}

-keep class org.lineageos.settings.display.* {
  *;
}

-keep class org.lineageos.settings.speaker.* {
  *;
}

-keep class org.lineageos.settings.refreshrate.* {
  *;
}

-keep class org.lineageos.settings.touchsampling.* {
  *;
}

-keep class org.lineageos.settings.thermal.* {
  *;
}

# Preserve the compatibility entry point used by already-pinned MiSound tiles.
-keep class org.lineageos.settings.dirac.DiracTileService {
  *;
}
