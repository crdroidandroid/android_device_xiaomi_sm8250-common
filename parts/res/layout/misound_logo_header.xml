<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="100dp" android:gravity="center"
    android:orientation="horizontal" android:paddingHorizontal="16dp"
    android:paddingVertical="16dp" android:importantForAccessibility="noHideDescendants">
    <ImageView android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/misound_logo" android:contentDescription="@null" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:text="@string/dirac_title"
        android:textSize="32sp" android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorPrimary" />
</LinearLayout>
