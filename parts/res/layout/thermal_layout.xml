<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/parts_list_item_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/thermal_system_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/thermal_system_profile_title"
                    android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                    android:textColor="@color/settingslib_materialColorOnSurface" />

                <TextView
                    android:id="@+id/thermal_system_header_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                    android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:id="@+id/thermal_system_expand"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/thermal_system_expand"
                android:padding="8dp"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/thermal_system_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/thermal_system_profile_summary"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />

            <TextView
                android:id="@+id/thermal_base_profile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/parts_icon_button_background"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_expand_more"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSecondaryContainer" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/thermal_profile_set_title"
                android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                android:textColor="@color/settingslib_materialColorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/thermal_profile_set_summary"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodySmall"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />

            <RadioGroup
                android:id="@+id/thermal_region_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/thermal_region_global"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/thermal_region_global" />

                <RadioButton
                    android:id="@+id/thermal_region_india"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/thermal_region_india" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        android:elevation="2dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="@string/thermal_app_overrides"
        android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
        android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/thermal_rv_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:scrollbarStyle="insideOverlay" />
</LinearLayout>
