<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/parts_list_item_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:id="@+id/thermal_detail_summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                android:textColor="@color/settingslib_materialColorOnSurface" />
            <TextView android:id="@+id/thermal_detail_meta"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/thermal_detail_clock_note"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodySmall"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/parts_list_item_background"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/thermal_detail_cpu_title"
                android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                android:textColor="@color/settingslib_materialColorOnSurface" />
            <TextView android:id="@+id/thermal_detail_cpu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/parts_list_item_background"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/thermal_detail_gpu_title"
                android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                android:textColor="@color/settingslib_materialColorOnSurface" />
            <TextView android:id="@+id/thermal_detail_gpu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/parts_list_item_background"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/thermal_detail_controls_title"
                android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                android:textColor="@color/settingslib_materialColorOnSurface" />
            <TextView android:id="@+id/thermal_detail_controls"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"
            android:background="@drawable/parts_list_item_background"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/thermal_detail_sensor_title"
                android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                android:textColor="@color/settingslib_materialColorOnSurface" />
            <TextView android:id="@+id/thermal_detail_sensor"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
